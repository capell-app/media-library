{
    "manifest-version": 3,
    "name": "capell-app/media-library",
    "slug": "media-library",
    "displayName": "Media Library",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "A Media Health page for finding images without alt text and unused files, with quarantine and a Spatie Media Library migration command.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\MediaLibrary",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": ["capell-app/media-ai", "capell-app/seo-suite"],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\MediaLibrary\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": ["Capell\\MediaLibrary\\MediaLibraryServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\MediaLibrary\\Manifest\\MediaHealthPageContribution",
            "pageClass": "Capell\\MediaLibrary\\Filament\\Pages\\MediaHealthPage",
            "labelKey": "capell-admin::navigation.media_health",
            "permission": "View:MediaHealthPage"
        },
        {
            "type": "model",
            "class": "Capell\\MediaLibrary\\Manifest\\CuratorMediaModelContribution",
            "modelClass": "Capell\\MediaLibrary\\Models\\CuratorMedia"
        },
        {
            "type": "configurator",
            "class": "Capell\\MediaLibrary\\Manifest\\MediaMigrationCommandContribution",
            "command": "capell:media-migrate-to-curator",
            "commandClass": "Capell\\MediaLibrary\\Console\\MigrateSpatieToCuratorCommand"
        },
        {
            "type": "health-check",
            "class": "Capell\\MediaLibrary\\Manifest\\MediaLibraryHealthContribution",
            "checkClass": "Capell\\MediaLibrary\\Health\\MediaLibraryHealthCheck"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\MediaLibrary\\Manifest\\MediaLibraryScheduleContribution",
            "command": "capell:media-purge-quarantined",
            "name": "capell-media-purge-quarantined",
            "frequency": "daily"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\MediaLibrary\\Manifest\\MediaLibraryScheduleContribution",
            "command": "capell:media-rebuild-structured-usage",
            "name": "capell-media-rebuild-structured-usage",
            "frequency": "daily"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["curator", "curator_structured_usages"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "buildDuplicateMediaQuery": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildDuplicateMediaQueryAction",
        "buildMediaHealthQuery": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildMediaHealthQueryAction",
        "buildMediaHealthTotals": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildMediaHealthTotalsAction",
        "buildMissingAltMediaQuery": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildMissingAltMediaQueryAction",
        "buildMissingRightsMetadataQuery": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildMissingRightsMetadataQueryAction",
        "buildMediaUsageDrilldown": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildMediaUsageDrilldownAction",
        "buildOrphanMediaQuery": "Capell\\MediaLibrary\\Actions\\DashboardReports\\BuildOrphanMediaQueryAction",
        "deleteOrphanMediaRecords": "Capell\\MediaLibrary\\Actions\\DashboardReports\\DeleteOrphanMediaRecordsAction",
        "dispatchMissingAltMediaSignals": "Capell\\MediaLibrary\\Actions\\DispatchMissingAltMediaSignalsAction",
        "migrateSpatieMediaToCurator": "Capell\\MediaLibrary\\Actions\\MigrateSpatieMediaToCuratorAction"
    },
    "settings": [],
    "permissions": ["View:MediaHealthPage", "Delete:MediaHealthPage"],
    "capabilities": [],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": ["View:MediaHealthPage", "Delete:MediaHealthPage"]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "media-library.curator-backend",
            "label": "Curator media backend is registered as the Capell media model and field factory.",
            "class": "Capell\\MediaLibrary\\Health\\MediaLibraryHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "media-library.health-report",
            "label": "Media health report identifies missing alt text, stale media, and unused assets.",
            "class": "Capell\\MediaLibrary\\Health\\MediaLibraryHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "media-library.spatie-migration",
            "label": "Spatie Media Library migration preserves metadata and owner foreign keys.",
            "class": "Capell\\MediaLibrary\\Health\\MediaLibraryHealthCheck",
            "severity": "warning",
            "surface": "console"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "See which images need alt text and which files nothing uses, and set unused ones aside before anything is deleted.",
        "description": "The Media Health page lists files missing alt text, files nothing uses and files not updated for 90 days, with each one's name, size and use count. From a row you can edit the alt text or quarantine an unused file, and one button quarantines all unused media. A command moves a Spatie Media Library install onto Curator. Builds on Curator.",
        "problem": "I don't know which images are missing alt text or never used, and I'm wary of deleting files without knowing.",
        "outcome": "One list shows what needs alt text and what nothing uses, and unused files go to quarantine before they are deleted.",
        "faq": [
            {
                "question": "Who can open the Media Health page?",
                "answer": "Only the super admin role across all sites. Editing alt text from a row needs permission to update media, and quarantining a file needs the delete permission."
            },
            {
                "question": "Does quarantine delete a file?",
                "answer": "Not straight away. Quarantine hides a file from the library and keeps it stored for 30 days by default. After that a daily background job deletes it for good if nothing has started using it."
            },
            {
                "question": "Can I bring in files from Spatie Media Library?",
                "answer": "Yes. Developers get a command that copies Spatie Media Library records into Curator and leaves the source files where they are."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/media-health-page.png",
                "alt": "Media health page listing three images with size, usage count and issue tags such as Missing alt text and Unused asset.",
                "caption": "Each row names what is wrong with a file and offers a next step such as editing its metadata."
            },
            {
                "path": "docs/screenshots/curator-media-field-inside-a-form.png",
                "alt": "Site edit form with a Media section offering Add media buttons for image, logo and inverted logo, and an icon upload area.",
                "caption": "Media fields in forms open the shared library, so editors pick a file instead of uploading it again."
            }
        ],
        "categories": ["admin", "foundation"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
